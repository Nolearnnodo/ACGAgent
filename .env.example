JWT_SECRET_KEY=please_change_this_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CONVERSATION_MEMORY_WINDOW=8

LLM_PROVIDER=deepseek
