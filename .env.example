APP_NAME=ACGAgent Graph Maintenance System
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

SQLITE_DATABASE_URL=sqlite:///./data/acg_agent.sqlite3

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please_change_me
NEO4J_DATABASE=neo4j

JWT_SECRET_KEY=please_change_this_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 忘记密码邮件。587 端口通常使用 STARTTLS；465 端口通常设置 USE_TLS=false、USE_SSL=true。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ACGAgent
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_CODE_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

CONVERSATION_MEMORY_WINDOW=8

LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-chat
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_TIMEOUT_SECONDS=120
PASSAGE_UPLOAD_CONCURRENCY=10

VITE_API_BASE_URL=http://localhost:8000/api/v1
