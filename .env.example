APP_NAME=ACGAgent Graph Maintenance System
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

SQLITE_DATABASE_URL=sqlite:///./data/acg_agent.sqlite3

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=please_change_me
